<Window x:Class="TextToSpeech.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Background="{DynamicResource ThemeBackground}" Foreground="{DynamicResource ThemeText}"
        Title="Settings" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16" MinWidth="380">
        <Expander x:Name="shellExpander" Header="Tray and background" Tag="shell">
            <StackPanel Margin="0,4,0,10">
                <CheckBox x:Name="startWithWindowsBox" Content="Start with Windows" Margin="0,0,0,6"
                          ToolTip="Starts hidden in the tray when you sign in to Windows."/>
                <CheckBox x:Name="closeToTrayBox" Content="Close button hides to tray" Margin="0,0,0,6"
                          ToolTip="The app keeps running in the tray. Exit is in the tray icon's menu."/>
                <CheckBox x:Name="apiBox" Content="Enable local API (127.0.0.1, for other programs)" Margin="0,6,0,4"
                          ToolTip="Lets programs on this computer send text to read and control reading. They need the token below."/>
                <DockPanel Margin="22,0,0,0">
                    <Button x:Name="copyTokenButton" DockPanel.Dock="Right" Content="Show file" Padding="10,0" Height="24" Click="ShowConnectionFile_Click"
                            ToolTip="Opens the folder with api.json (port and token). The token is never put on the clipboard."/>
                    <TextBlock x:Name="apiInfoText" TextWrapping="Wrap" Foreground="{DynamicResource ThemeSubtle}" FontSize="12" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Expander>

        <Expander x:Name="popupExpander" Header="Reading popup" Tag="popup">
            <StackPanel Margin="0,4,0,10">
                <CheckBox x:Name="showPopupBox" Content="Show reading popup when reading starts" Margin="0,0,0,6"
                          ToolTip="A small window above the tray with the text being read, shown only while the full window is hidden."/>
                <CheckBox x:Name="popupAutoHideBox" Content="Hide popup when reading finishes" Margin="22,0,0,6"/>
                <CheckBox x:Name="popupKeepBox" Content="Keep popup open when paused" Margin="22,0,0,6"
                          ToolTip="Off: pausing or stopping hides the popup until reading resumes."/>
                <TextBlock Text="Text size" FontWeight="SemiBold" Margin="0,6,0,0"/>
                <DockPanel Margin="0,6,0,8">
                    <TextBlock x:Name="popupTextSizeText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider x:Name="popupTextSizeSlider" Minimum="10" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="2" VerticalAlignment="Center"/>
                </DockPanel>
                <Border BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Padding="8" Height="86">
                    <TextBlock x:Name="popupPreviewText" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Text="This is how the text in the reading popup will look. The quick brown fox jumps over the lazy dog."/>
                </Border>
            </StackPanel>
        </Expander>

        <Expander x:Name="opacityExpander" Header="Opacity" Tag="opacity">
            <StackPanel>
                <TextBlock Text="Window opacity" FontWeight="SemiBold"/>
                <DockPanel Margin="0,6,0,14">
                    <TextBlock x:Name="opacityText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider x:Name="opacitySlider" Minimum="30" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="5" VerticalAlignment="Center"/>
                </DockPanel>

                <TextBlock Text="Pop-up opacity" FontWeight="SemiBold"/>
                <DockPanel Margin="0,6,0,14">
                    <TextBlock x:Name="popupOpacityText" DockPanel.Dock="Right" Width="44" TextAlignment="Right" VerticalAlignment="Center"/>
                    <Slider x:Name="popupOpacitySlider" Minimum="30" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"
                            SmallChange="1" LargeChange="5" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Expander>

        <TextBlock Text="Pause between sentences" FontWeight="SemiBold"/>
        <DockPanel Margin="0,6,0,14">
            <TextBlock x:Name="gapText" DockPanel.Dock="Right" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider x:Name="gapSlider" Minimum="0" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True"
                    SmallChange="50" LargeChange="200" VerticalAlignment="Center"/>
        </DockPanel>

        <CheckBox x:Name="autoClearBox" Content="Clear the text a few seconds after reading finishes" Margin="0,0,0,6"
                  ToolTip="Same as the Clear button. A new read or new text in the meantime cancels it."/>
        <DockPanel Margin="22,0,0,14">
            <TextBlock x:Name="autoClearText" DockPanel.Dock="Right" Width="60" TextAlignment="Right" VerticalAlignment="Center"/>
            <Slider x:Name="autoClearSlider" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"
                    SmallChange="1" LargeChange="5" VerticalAlignment="Center"/>
        </DockPanel>

        <CheckBox x:Name="autoShowBox" Content="Bring the window up when reading starts and hide it when reading ends" Margin="0,0,0,14"
                  ToolTip="Pausing keeps the window up so you can resume. It only minimizes again if the app brought it up and you did not click or switch to it meanwhile."/>

        <DockPanel Margin="0,14,0,14">
            <Button x:Name="ocrButton" DockPanel.Dock="Right" MinWidth="110" Height="28" Padding="10,0" Click="OcrButton_Click"
                    ToolTip="Windows: built-in OCR, fast, uses the Windows language packs. Tesseract: works offline from the bundled data.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ocrButtonText" Text="Windows" VerticalAlignment="Center"/>
                    <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="10,1,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource ThemeSubtle}"/>
                </StackPanel>
            </Button>
            <TextBlock Text="OCR engine (for Read Region)" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </DockPanel>

        <Expander x:Name="hotkeyExpander" Header="Hotkeys" Tag="hotkeys">
            <StackPanel>
            <TextBlock Text="Click a box, then press the new shortcut. Backspace puts the default back." Margin="0,2,0,6"
                       TextWrapping="Wrap" Foreground="{DynamicResource ThemeSubtle}" FontSize="12"/>
            <Grid x:Name="hotkeyGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Text="Read selected text" Margin="0,4,12,4" ToolTip="The window stays hidden"/>
                <TextBox x:Name="readBox" Grid.Column="1" IsReadOnly="True" Margin="0,2" Tag="ReadSelection" PreviewKeyDown="Capture_PreviewKeyDown"/>
                <TextBlock Text="Read selected text and show window" Grid.Row="1" Margin="0,4,12,4" ToolTip="The window is minimized again when reading ends, if it was hidden"/>
                <TextBox x:Name="readShowBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,2" Tag="ReadSelectionAndShow" PreviewKeyDown="Capture_PreviewKeyDown"/>
                <TextBlock Text="Show window" Grid.Row="2" Margin="0,4,12,4"/>
                <TextBox x:Name="summonBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Margin="0,2" Tag="SummonWindow" PreviewKeyDown="Capture_PreviewKeyDown"/>
                <TextBlock Text="Read screen region and show window" Grid.Row="3" Margin="0,4,12,4" ToolTip="The window comes up after you finish the selection, and goes back down after reading if the app raised it"/>
                <TextBox x:Name="regionBox" Grid.Row="3" Grid.Column="1" IsReadOnly="True" Margin="0,2" Tag="ReadRegion" PreviewKeyDown="Capture_PreviewKeyDown"/>
                <TextBlock Text="Read screen region, window stays as it is" Grid.Row="4" Margin="0,4,12,4"/>
                <TextBox x:Name="regionQuietBox" Grid.Row="4" Grid.Column="1" IsReadOnly="True" Margin="0,2" Tag="ReadRegionQuiet" PreviewKeyDown="Capture_PreviewKeyDown"/>
                <TextBlock Text="Play / pause" Grid.Row="5" Margin="0,4,12,4"/>
                <TextBox x:Name="playPauseBox" Grid.Row="5" Grid.Column="1" IsReadOnly="True" Margin="0,2" Tag="PlayPause" PreviewKeyDown="Capture_PreviewKeyDown"/>
                <TextBlock Text="Clear everything" Grid.Row="6" Margin="0,4,12,4"/>
                <TextBox x:Name="clearBox" Grid.Row="6" Grid.Column="1" IsReadOnly="True" Margin="0,2" Tag="ClearAll" PreviewKeyDown="Capture_PreviewKeyDown"/>
            </Grid>
            <TextBlock x:Name="hotkeyMessage" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="#E5484D" FontSize="12" Visibility="Collapsed"/>
            </StackPanel>
        </Expander>

        <Button Content="Close" IsDefault="True" IsCancel="True" HorizontalAlignment="Right" Width="80" Height="28" Margin="0,14,0,0" Click="Close_Click"/>
    </StackPanel>
</Window>
