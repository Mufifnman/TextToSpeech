<Window x:Class="TextToSpeech.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TextToSpeech"
        xmlns:l="clr-namespace:TextToSpeech"
        Title="Text to Speech" Height="400" Width="780" GotFocus="Window_GotFocus_1" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <local:EnumToEnumerableConverter x:Key="EnumToEnumerableConverter" />
    </Window.Resources>
    <Grid Margin="0,0,0,-5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="textbox" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Text="Test"/>
            <local:ReadingDisplay x:Name="__ReadListDisplay__" Grid.Column="1"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="___ReadButton_" Content="Go!" Grid.Column="0" Click="ReadText" Focusable="False"/>
                <Button x:Name="___RewindButton_" Content="&#9198; Back" Grid.Column="1" Click="Rewind_Click" Focusable="False" ToolTip="Restart sentence, or go back one (Ctrl+Left)"/>
                <Button x:Name="___PauseButton_" Content="&#9199; Pause" Grid.Column="2" Click="PlayPause_Click" Focusable="False" ToolTip="Play / pause (Space, or Ctrl+Space while typing)"/>
                <Button x:Name="___SkipButton_" Content="Skip &#9197;" Grid.Column="3" Click="Skip_Click" Focusable="False" ToolTip="Next sentence (Ctrl+Right)"/>
                <Button x:Name="___StopButton_" Content="Stop!" Grid.Column="4" Click="StopRead" Focusable="False"/>
                <Button x:Name="___ClearButton" Content="Clear!" Grid.Column="5" Click="ClearList" Focusable="False"/>
                <Button x:Name="__ImageRead" Content="Read Region" Grid.Column="6" Click="ImageRead" Focusable="False" ToolTip="Drag a box around text on screen to read it aloud"/>
                <Button x:Name="__ReadAgain" Content="Again" Grid.Column="7" Padding="8,0" IsEnabled="False" Click="ReadSameRegion" Focusable="False" ToolTip="Read the same screen region again (for example after scrolling)"/>
                </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Slider x:Name="__Speed__" Grid.Row="1" Minimum="-2" SmallChange="1" Value="4" ValueChanged="SpeedChanged" />
                <StackPanel Grid.Column="2" Orientation="Horizontal"  HorizontalAlignment="Right" >
                    <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,8,0">
                        <MenuItem x:Name="filtersMenu" Header="Filters" ToolTip="Choose which clean-up filters run on copied or scanned text"><!-- items are built from FilterRegistry in code --></MenuItem>
                    </Menu>
                    <Button Content="Hotkeys..." Click="HotkeySettings_Click" Margin="0,0,8,0" Padding="6,0"/>
                    <Button x:Name="voiceButton" Content="&#x1F50A;" Click="VoiceButton_Click" Margin="0,0,8,0" Padding="8,0"
                            ToolTip="Choose the voice">
                        <Button.ContextMenu>
                            <ContextMenu x:Name="voiceMenu" />
                        </Button.ContextMenu>
                    </Button>
                    <TextBlock Text="OCR: " Margin="0,3,0,4" />
                    <ComboBox x:Name="ocrOptionsComboBox" SelectionChanged="OcrOptionsComboBox_SelectionChanged" 
                        ItemsSource="{Binding Source={x:Type local:OcrOptions}, Converter={StaticResource EnumToEnumerableConverter}}"
                        SelectedIndex="0">
                    </ComboBox>
                </StackPanel>
            </Grid>
            <TextBlock x:Name="statusText" Grid.Row="2" Text="" Foreground="DarkRed" Margin="4,0" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</Window>
