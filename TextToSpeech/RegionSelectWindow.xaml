<Window x:Class="TextToSpeech.RegionSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select text to read"
        WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        Background="#01000000" Topmost="True" ShowInTaskbar="False"
        Cursor="Cross" FocusVisualStyle="{x:Null}"
        MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp"
        MouseRightButtonUp="OnCancel" KeyDown="OnKeyDown">
    <Canvas x:Name="Root">
        <!-- Dim everything except the selected rectangle (even-odd fill punches the hole). -->
        <Path Fill="#80000000" IsHitTestVisible="False">
            <Path.Data>
                <GeometryGroup FillRule="EvenOdd">
                    <RectangleGeometry x:Name="FullRect" />
                    <RectangleGeometry x:Name="HoleRect" />
                </GeometryGroup>
            </Path.Data>
        </Path>

        <Rectangle x:Name="SelectionBorder" Stroke="#FFFFD54F" StrokeThickness="2"
                   Visibility="Collapsed" IsHitTestVisible="False" />

        <Border x:Name="SizeLabel" Background="#E0202020" CornerRadius="3" Padding="6,2"
                Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
        </Border>

        <Border x:Name="Hint" Background="#E0202020" CornerRadius="6" Padding="16,10" IsHitTestVisible="False">
            <TextBlock Foreground="White" FontSize="16" TextAlignment="Center">
                <Run FontWeight="SemiBold">Drag a box around the text you want read.</Run>
                <LineBreak />
                <Run Foreground="#FFBDBDBD" FontSize="13">Esc or right-click to cancel</Run>
            </TextBlock>
        </Border>
    </Canvas>
</Window>
